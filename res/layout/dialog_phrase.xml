<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F8FAFC">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="★ 自定义拼音词库与造词管理"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#0F172A" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="录入专有名词、业务简称及拼音（支持全拼与首字母简拼，如 dhjk 对应东航金控），输入时将带★置顶候选。"
        android:textSize="12sp"
        android:textColor="#64748B"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/et_new_phrase_word"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/edittext_color"
        android:hint="词组文字（例：东航金控、商发陶瓷基）"
        android:textColorHint="#94A3B8"
        android:textColor="#0F172A"
        android:textSize="15sp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:singleLine="true" />

    <EditText
        android:id="@+id/et_new_phrase_pinyin"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/edittext_color"
        android:hint="对应拼音/简拼（例：donghangjinkong, dhjk）"
        android:textColorHint="#94A3B8"
        android:textColor="#0F172A"
        android:textSize="15sp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:singleLine="true"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btn_save_phrase"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="+ 添加/更新到自造词库"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:background="@drawable/btn_amber"
        android:layout_marginTop="10dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#CBD5E1"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/tv_phrase_list_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="已有自造词组列表："
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#1E293B"
        android:layout_marginBottom="6dp" />

    <ListView
        android:id="@+id/lv_user_phrases"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:divider="#E2E8F0"
        android:dividerHeight="1dp"
        android:choiceMode="none" />

    <Button
        android:id="@+id/btn_close_phrase_dialog"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:text="关闭"
        android:textColor="#475569"
        android:background="@drawable/btn_eink"
        android:layout_marginTop="12dp" />
</LinearLayout>
